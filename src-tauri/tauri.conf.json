{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskMind",
  "version": "0.1.0",
  "identifier": "com.diskmind.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DiskMind",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "backgroundColor": "#06080d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
